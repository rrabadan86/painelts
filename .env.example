# Segredo para assinar a sessão. Gere com:  openssl rand -hex 32
SESSION_SECRET=
# Horas até pedir login de novo
SESSION_HOURS=12
# Deixe true quando o painel estiver atrás de HTTPS (recomendado)
COOKIE_SECURE=true

# Minutos que o painel guarda os dados que vêm do Google Drive antes de ler de novo.
# Arquivos enviados para a VPS são detectados na hora, sem esperar.
CACHE_MINUTES=10

# Tamanho máximo de cada planilha enviada pelo script (MB)
MAX_UPLOAD_MB=80

# Lojas, usuários e token de upload ficam em config/lojas.json
# (crie e edite com: docker compose exec teashop-painel node scripts/admin.js ...)

PORT=3000

# Botão "Atualizar dados do sistema" (roda o script da loja no GitHub Actions).
# Token "fine-grained" do GitHub com acesso SÓ aos repositórios das lojas e
# permissão "Actions: Read and write". Depois ligue cada loja com:
#   node scripts/admin.js github <loja> <dono/repositorio>
GITHUB_TOKEN=

# ---------- Coletor (script das lojas rodando na VPS) ----------
# Senha interna entre o painel e o coletor. Gere com:  openssl rand -hex 32
COLETOR_TOKEN=
# Horários das execuções automáticas (horário de Brasília), separados por vírgula
COLETOR_HORARIOS=13:30,23:00
# (os horários também podem ser trocados em Configurações → Atualização automática)
# Quantos dias a rotina baixa do AppNext a cada execução (o histórico fica guardado mês a mês)
COLETOR_JANELA=7

# Copie para <id-da-loja>.env (ex.: torres.env) e preencha com os MESMOS valores
# dos secrets do repositório da loja no GitHub. Este arquivo fica só na VPS.
#   cp exemplo.env.modelo torres.env && chmod 600 torres.env && nano torres.env

# === Login no AppNext ===
APPNEXT_REDE=teashop
APPNEXT_USER=
APPNEXT_PASS=

# === Loja dentro do AppNext (opcional; use se o usuário tiver acesso a mais de uma loja) ===
APPNEXT_LOJA_DESTINO=
APPNEXT_LOJA_ID_DESTINO=

# === Período do relatório (dd/mm/aaaa). DATA_FIM vazio = hoje ===
DATA_INICIO=01/06/2025
DATA_FIM=
# Alternativa: janela móvel em dias (deixe DATA_INICIO vazio para usar)
# DIAS_JANELA=60

# Tempo máximo de cada execução, em segundos
MAX_RUNTIME_SECONDS=600

# === Sistema de Pedidos da franqueadora (grnteashop.nextsoft.com.br/Pedidos) — opcional ===
# Login da loja no site de pedidos. Com ele o coletor lê o catálogo toda noite (preço, disponível, múltiplo)
# e o painel pode montar o carrinho (aba Pedido). O robô nunca finaliza o pedido.
PEDIDO_USER=
PEDIDO_PASS=
# PEDIDO_URL=https://grnteashop.nextsoft.com.br/Pedidos/
